{
  "version": 2,
  "build": {
    "env": {
      "VITE_CONFIG_NATIVE_IGNORE_WARNING": "true"
    }
  },
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "api/_bundle.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
