# ==============================================================================
# UCHIHA MARRI TOP UP — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env for local development or configure these variables
# in your Vercel Project Settings -> Environment Variables.
# IMPORTANT: Never commit real credentials or secrets to GitHub!

# ------------------------------------------------------------------------------
# 1. PAYHERE CHECKOUT GATEWAY (SERVER-ONLY SECRETS)
# ------------------------------------------------------------------------------
# Your PayHere Merchant ID (from PayHere Merchant Portal -> Settings -> Domains & Credentials)
PAYHERE_MERCHANT_ID=

# SERVER-ONLY: Your domain-specific PayHere Merchant Secret (NEVER expose to frontend)
PAYHERE_MERCHANT_SECRET=

# Set to "true" for PayHere Sandbox testing or "false" after live merchant approval
PAYHERE_SANDBOX=true

# ------------------------------------------------------------------------------
# 2. APPLICATION URL & STORE CONFIGURATION
# ------------------------------------------------------------------------------
# Trusted server-side base URL used for PayHere return_url, cancel_url, and notify_url
APP_BASE_URL=

# Official business WhatsApp number for customer order support
BUSINESS_WHATSAPP=

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (SUPABASE / POSTGRESQL)
# ------------------------------------------------------------------------------
# Public/Server URL of your Supabase project (if using external Supabase API)
SUPABASE_URL=

# Public anonymous key for Supabase client (safe for public use with Row Level Security)
SUPABASE_ANON_KEY=

# SERVER-ONLY: Supabase Service Role key (bypasses RLS — NEVER expose in frontend code!)
SUPABASE_SERVICE_ROLE_KEY=

# Cloud SQL / PostgreSQL Object-Method Connection Variables (Server-Only)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & ADMINISTRATOR SECURITY (SERVER-ONLY SECRETS)
# ------------------------------------------------------------------------------
# SERVER-ONLY: Secret key used to sign and verify customer JWT session & order access tokens
AUTH_SECRET=

# SERVER-ONLY: Secret key required to authorize updates to /api/payhere/config
ADMIN_SECRET=

# SERVER-ONLY: Authorized administrator email address
ADMIN_EMAIL=

# ------------------------------------------------------------------------------
# 5. BUILD & BUNDLER CONFIGURATION
# ------------------------------------------------------------------------------
# Suppress Vite native config loader deprecation warning for future Vite versions
VITE_CONFIG_NATIVE_IGNORE_WARNING=true
